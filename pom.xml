<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.6</version>
        <relativePath/>
    </parent>

    <groupId>com.nomad.tax</groupId>
    <artifactId>nomad-tax-calculation-engine</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>Nomad synthetic tax calculation engine — G2 skeleton, no source code</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- ADR-008: four-module clean architecture — dependency direction inward only -->
    <modules>
        <module>backend/tax-domain</module>
        <module>backend/tax-usecases</module>
        <module>backend/tax-interface-adapters</module>
        <module>backend/tax-frameworks</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.nomad.tax</groupId>
                <artifactId>tax-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nomad.tax</groupId>
                <artifactId>tax-usecases</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nomad.tax</groupId>
                <artifactId>tax-interface-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
